# ---- Server (Render) --------------------------------------------------
SGK_NETWORK=sgk-devnet          # sgk-mainnet | sgk-testnet | sgk-devnet
SGK_DIFFICULTY=18               # required leading zero bits for PoW
SGK_AUTO_MINE=true              # background auto-miner on/off
SGK_DATA_DIR=./data             # where chain/UTXO/faucet state is persisted
SGK_GENESIS_TIMESTAMP=1735689600  # fixed unix seconds, keeps genesis reproducible
SGK_GENESIS_ALLOCATION_ADDRESS= # optional: pre-mine address
SGK_GENESIS_ALLOCATION_AMOUNT=0 # base units (8 decimals)
SGK_FAUCET_ENABLED=true         # auto-disabled on sgk-mainnet regardless
SGK_FAUCET_AMOUNT=1000000000    # base units (10 SGK)
SGK_FAUCET_COOLDOWN_SECONDS=3600
SGK_MINER_ADDRESS=              # optional: mine rewards to your own wallet
PORT=8545                       # Render sets this automatically; harmless to leave

# ---- Web (Vercel) ------------------------------------------------------
NEXT_PUBLIC_SGK_NODE_URL=https://your-node.onrender.com
NEXT_PUBLIC_SGK_NETWORK_MODE=devnet   # mainnet | testnet | devnet — must match the node

# ---- CLI wallet ---------------------------------------------------------
SGK_NODE_URL=https://your-node.onrender.com
SGK_NETWORK_MODE=devnet
SGK_WALLET_DIR=~/.sgk-wallet
